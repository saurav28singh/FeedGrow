# FeedGrow Environment Configuration Example
# Copy this file to .env.local for local development.
# Do NOT commit .env.local or real secrets to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL=https://feedgrow.com

# Analytics & Monitoring (Optional)
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Contact / Lead Notification Webhook or API Endpoint (Optional)
# CONTACT_FORM_WEBHOOK_URL=
